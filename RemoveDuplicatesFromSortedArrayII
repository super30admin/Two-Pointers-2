class Solution {
    /* Approach:  Given--> Array is sorted. We can use 2 pointer solution.
    1 pointer to keep track of index where we can store the element and other pointer to go over all the numbers.
        Time complexity : o(n) where n is array length
        space complexity :(1)
        */
    public int removeDuplicates(int[] nums) {
        int k = 2;
        int slow = 1;
        int fast = 1;
        int countOfCurrElem = 1;
        // 2 steps process.
        //1. count how many times each element has occured
        //2. if count<=k, copy element to slow and increment slow and fast. if count has already exceeded k then dont copy. only move fast pointer.

        while (fast < nums.length) {
            //if same as previous
            if (nums[fast] == nums[fast - 1]) {
                countOfCurrElem++;
            } else {
                countOfCurrElem = 1;

            }

            if (countOfCurrElem <= k) {
                nums[slow] = nums[fast];
                slow++;
                fast++;
            } else {
                fast++;
            }

        }
        return slow;

    }

}
