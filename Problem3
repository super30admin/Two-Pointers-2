class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {
        if(matrix == null || matrix.length == 0){
            return false;
        }
        //if we start from top right corner, if we go left, numbers keep decreases and from top to bottom no.s keep increasing
        int i = 0;
        int j = matrix[0].length - 1;
        while(i <= matrix.length - 1 && j >= 0){
            if(matrix[i][j] == target){
                return true;
            }
            //if target < number, move left(col--)
            else if(matrix[i][j] > target){
               j--;
            }
            //if target > number, move downwards(row++)
            else{
                i++;
            }
        }
        return false;
    }
}
