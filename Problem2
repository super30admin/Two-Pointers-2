class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        if(nums2 == null || nums2.length == 0){
            return ;
        }
        //as arrays are sorted, use 2-pointers technique which keeps track of max elements in each array and last element in nums1
        int p1 = m-1;
        int p2 = n-1;
        int p3 = m+n-1;
        while(p1 >= 0 && p2 >= 0){
            //strating from nums1 last index, fill max(max elements in nums1 and nums2) and move the pointer to before element
            if(nums1[p1] >= nums2[p2]){
                nums1[p3] = nums1[p1];
                p1--;
            }
            else{
                nums1[p3] = nums2[p2];
                p2--;
            }
            p3--;

        }
        //after p1 elements sorted but p2 still have elements, fill them from p3
        if(p2 >= 0){
            while(p2 >= 0){
                nums1[p3] = nums2[p2];
                p2--;
            }
        }
    }
}
